# Провайдер номеров: PVACodes (beta.pvacodes.com). Аккаунт + баланс обязательны.
PROVIDER=pvacodes
PVACODES_EMAIL=you@example.com
PVACODES_PASSWORD=your_password

# Какой товар арендовать. Это и есть "номера": нужны реальные Jio-номера,
# поэтому Jio50. Через запятую — очередь на случай пустого пула.
PVACODES_SERVICE=Jio50
PVACODES_COUNTRY=India

# Лимиты
MAX_PRICE=1.0
OTP_TIMEOUT_SECONDS=180
CONCURRENCY=2
DB_PATH=results.db
LINKS_DIR=links

# Telegram: токен от @BotFather и свой chat_id. Без них ссылки только в файл.
TG_BOT_TOKEN=
TG_CHAT_ID=

# Прокси (по умолчанию выключены, трафик идёт напрямую)
PROXY_ENABLED=0
# file — локальный список, по одному прокси в строке (host:port или scheme://host:port).
# proxygrab — HTTP API поставщика списков; требует PROXYGRAB_URL и PROXYGRAB_KEY.
PROXY_SOURCE=file
PROXY_FILE=
PROXYGRAB_URL=
PROXYGRAB_KEY=
PROXY_POOL_SIZE=10
PROXY_ROTATE_SECONDS=600
PROXY_PROTO=
PROXY_COUNTRY=
PROXY_ANON=elite
PROXY_TEST_URL=https://www.jio.com/
PROXY_VERIFY=1
PROXY_VERIFY_TIMEOUT=20
PROXY_SESSIONS=0
